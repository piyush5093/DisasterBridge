# --- App ---
APP_NAME="Disaster Response Management System"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=True

# --- Database (MongoDB) ---
MONGODB_URL=mongodb://disaster_admin:disaster_pass@localhost:27017/disaster_response?authSource=admin
MONGODB_DB_NAME=disaster_response

# --- Redis / Celery (optional, wired later) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- External APIs ---
GDACS_API_BASE=https://www.gdacs.org/gdacsapi/api
USGS_EARTHQUAKE_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1

# NDMA's public CAP feed (sachet.ndma.gov.in) needs no API key for the
# FetchXMLFile endpoint per its published integration guide; NDMA_API_KEY
# is unused for now — kept in case a documented discovery/listing endpoint
# turns out to require one (see ndma_client.py's docstring).
NDMA_API_KEY=

# Required for satellite imagery (app/services/external/sentinel_hub_client.py).
# Register an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/#/
# (Copernicus Data Space Ecosystem — the platform Sentinel Hub migrated to).
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
